{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/lib/pre-tool-entry.js\""
          }
        ]
      },
      {
        "matcher": "local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/lib/pre-tool-entry.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|apply_patch|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/trunk-sync.sh",
            "statusMessage": "Syncing to trunk"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/trunk-sync-session-start.sh",
            "statusMessage": "Reading trunk-sync active sessions"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/trunk-sync-stop.sh",
            "statusMessage": "Clocking out of trunk-sync"
          }
        ]
      }
    ]
  }
}
